{
  "manifest_version": 3,
  "name": "Gemini Nano A11y Auditor",
  "version": "1.0",
  "description": "Client-side accessibility testing using on-device AI.",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "debugger"
  ],
  "host_permissions": ["<all_urls>", "https://www.w3.org/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
